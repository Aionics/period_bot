# Токен от @BotFather
BOT_TOKEN=
# Ключ шифрования данных. Создаётся автоматически скриптом install.sh.
# ВАЖНО: если ключ потерять, данные расшифровать будет нельзя.
CRYPT_KEY=
# Код приглашения: бот пускает только по ссылке t.me/<бот>?start=<код>. Пусто — пускает всех.
INVITE_CODE=
# Твой Telegram ID — только для команды /count (число пользователей, без имён)
ADMIN_IDS=
DB_PATH=data/cycle.db
